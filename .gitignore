.env

# ASR (faster-whisper/PhoWhisper) and TTS (VieNeu-TTS) model weights --
# host-downloaded and bind-mounted into their containers (see asr/download_model.py,
# tts/download_vieneu_model.py), not meant to live in git.
asr/model-src/
tts/vieneu-hf-cache/

# Captured ESP32 serial output from scripts/monitor_esp32.sh
logs/

# Server runtime data (bind-mounted in docker-compose.yml). avatars/ stays tracked.
server/data/recordings/
server/data/mictest/
server/data/firmware/
server/data/cms-uploads/

# Python bytecode, FreeCAD auto-backups
__pycache__/
*.FCBak
