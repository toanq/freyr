# Copy this file to .env and fill in real values. .env is gitignored.

POSTGRES_PASSWORD=synora_dev

# Public hostnames (no scheme, no trailing slash). Docker compose passes them
# to Traefik (landing host routing) and to the server as Domain__App /
# Domain__Landing (OTA download URLs, CORS). Defaults if unset:
#   SYNORA_DOMAIN=synora.carcise.dev           -> https://synora.carcise.dev (web console + /api)
#   LANDING_DOMAIN=synora-landing.carcise.dev  -> https://synora-landing.carcise.dev (landing + CMS)
# Example for a different deployment:
#   SYNORA_DOMAIN=app.example.com
#   LANDING_DOMAIN=www.example.com
SYNORA_DOMAIN=synora.carcise.dev
LANDING_DOMAIN=synora-landing.carcise.dev

# Optional: override the OTA firmware download base URL. Leave blank to use
# https://$SYNORA_DOMAIN/api. Example:
#   FIRMWARE_PUBLIC_BASE_URL=https://cdn.example.com/api
FIRMWARE_PUBLIC_BASE_URL=

# Web console login (SuperAdmin, seeded on first startup if no users exist yet).
# Leave blank to disable login until configured — the server logs a warning
# at startup telling the admin to set these.
Dashboard__Username=
Dashboard__Password=

# Mobile app auth (JWT). Leave blank to disable /auth/register, /auth/token
# and OAuth login until configured.
Jwt__SigningKey=

# Google Sign-In (mobile). Client ID from Google Cloud Console.
OAuth__Google__ClientId=

# Google Sign-In for the web console: a separate OAuth client of type
# "Web application" in the same Google Cloud project, with your public origin
# (e.g. https://synora.carcise.dev) under "Authorized JavaScript origins".
# The server accepts it as an ID-token audience, and docker compose bakes it
# into the web build (VITE_GOOGLE_CLIENT_ID). Leave blank to hide the button.
# Example:
#   OAuth__Google__WebClientId=1234567890-abcdefg.apps.googleusercontent.com
OAuth__Google__WebClientId=

# Facebook Login (mobile + web console). App ID/Secret from
# developers.facebook.com. The App ID is also baked into the web build
# (VITE_FACEBOOK_APP_ID) -- add your public domain to the app's
# "App Domains" and enable "Login with the JavaScript SDK". Blank hides the
# web button. Example:
#   OAuth__Facebook__AppId=123456789012345
OAuth__Facebook__AppId=
OAuth__Facebook__AppSecret=

# Firebase Cloud Messaging (push notifications). The full service-account
# JSON key as a single line, from Firebase Console > Project Settings >
# Service Accounts > Generate new private key. Leave blank to disable
# push notifications until configured.
Firebase__ServiceAccountJson=

# Web push in the web console (same Firebase project as above). Baked into
# the web build; leave any blank to hide the "Bật thông báo" opt-in.
# Firebase Console > Project settings > General > Your apps > Web app (add one
# if missing) gives the first four; Project settings > Cloud Messaging > Web
# configuration > Web Push certificates > Generate key pair gives the VAPID key.
# Example:
#   FIREBASE_WEB_API_KEY=AIzaSyA1b2C3d4E5f6G7h8I9j0KlMnOpQrStUvW
#   FIREBASE_WEB_PROJECT_ID=synora-12345
#   FIREBASE_WEB_MESSAGING_SENDER_ID=123456789012
#   FIREBASE_WEB_APP_ID=1:123456789012:web:abc123def456
#   FIREBASE_WEB_VAPID_KEY=BExampleExampleExampleExampleExampleExampleExampleExampleExampleExampleExampleExampleExa
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_VAPID_KEY=
